# ============================================================
# JAYU_JAR — variables de entorno LOCALES (NO subir al repo)
# Copia este archivo a ".env" y rellena SOLO lo que necesites.
# Cualquier clave con prefijo JAYU_ sobreescribe config/ en runtime.
# ============================================================

# --- LLM local (Ollama) ---
JAYU_OLLAMA_HOST=127.0.0.1
OLLAMA_HOST=127.0.0.1:11434
# OLLAMA_API_KEY=            # solo si tu servidor Ollama la exige

# --- Proveedores externos (de pago) — DESACTIVADOS por defecto ---
# Para usarlos, pon enabled: true en config/models.yaml Y define la clave aquí.
# OPENAI_API_KEY=
# OPENAI_COMPATIBLE_API_KEY=
# OPENAI_COMPATIBLE_BASE_URL=http://127.0.0.1:8000/v1

# --- Autonomía / seguridad ---
# read_only | confirm_before_execution | autonomous
# JAYU_AUTONOMY_LEVEL=confirm_before_execution

# --- Trading (Fase 6) ---
# JAYU_TRADING_MODE=READ_ONLY          # READ_ONLY | CONFIRM_BEFORE_EXECUTION
# JAYU_AUTONOMOUS_TRADING=false        # NUNCA true por defecto

# --- Raíz del proyecto (si no se lee desde el repo) ---
# JAYU_ROOT=